# Optional local MongoDB for future milestones. Values are placeholders only.
# Never commit an actual password, token, or production connection string.
AUDITOR_METADATA_MONGODB_URI=mongodb://localhost:27017/migration_auditor_metadata
TARGET_MONGODB_URI=mongodb://localhost:27017/example_application
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_QUERY_TIMEOUT_MS=10000

# Web API: comma-separated browser origins permitted to call the API.
# Use the exact deployed Vercel origin in production; this is not a secret.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local product MVP. SQLite is for development only; configure PostgreSQL before production.
# Set both values once to create the first platform administrator. Do not commit real credentials.
PRODUCT_DATABASE_PATH=migration_auditor_product.sqlite3
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set true only behind HTTPS. Cross-site frontend/API deployments need this enabled.
SESSION_COOKIE_SECURE=false

# Small local-only setup: exposes a read-only, in-memory admin summary.
# Never enable this on an internet-facing deployment.
SIMPLE_ADMIN_MODE=false
# Used only if SIMPLE_ADMIN_MODE=true. Override these before sharing your local screen.
SIMPLE_ADMIN_EMAIL=admin@mongoauditor.local
SIMPLE_ADMIN_PASSWORD=Admin@12345!

# Frontend build setting (set it in Vercel, not in a committed .env file).
# AUDITOR_API_URL=https://your-api-host.example
